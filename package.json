{
  "name": "sharemii",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/sync-db.mjs && vite",
    "db:sync": "node scripts/sync-db.mjs",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:tl-names": "node scripts/generate-tl-item-names.mjs",
