    "vite": "^8.0.12",
    "vitest": "^3.2.4",
    "wrangler": "^4.54.0"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@supabase/supabase-js": "^2.105.4",
    "@tensorflow-models/toxicity": "^1.2.2",
    "@tensorflow/tfjs": "^4.22.0",
    "chart.js": "^4.5.1",
    "jsqr": "^1.4.0",
    "linkify-it": "^5.0.0",
    "miijs": "^3.0.7"
  }
