VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase Dashboard → Authentication → URL Configuration (add all of these):
# Site URL: https://sharemii.net  (or http://localhost:5173 for local dev)
# Redirect URLs:
#   http://localhost:5173
#   http://127.0.0.1:5173
#   http://localhost:4173
#   https://sharemii.net
#   https://www.sharemii.net
#
# Enable Email provider (password sign-in) and Google/GitHub OAuth as needed.
# OAuth redirect uses the current page URL on an allowed origin (see src/services/auth.ts).

# Optional: auto-sync supabase/sync.sql on npm run dev (Dashboard → Database → Connection string)
# DATABASE_URL=postgresql://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
# SUPABASE_DB_PASSWORD=
