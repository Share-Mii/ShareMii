VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: Discord invite shown in header, footer, login, and home hero
# VITE_DISCORD_INVITE_URL=https://discord.gg/your-invite

# GitHub Actions (Settings → Secrets and variables → Actions → Repository secrets):
#   VITE_SUPABASE_URL
#   VITE_SUPABASE_ANON_KEY
#   CLOUDFLARE_API_TOKEN
#   CLOUDFLARE_ACCOUNT_ID  (f16e70493ac68fe9b91d0bad3b925499)
# Optional:
#   VITE_ANALYTICS_SCRIPT_URL
#
# Cloudflare Pages env vars (Dashboard → Workers & Pages → sharemii → Settings → Environment variables):
#   SUPABASE_URL          (same value as VITE_SUPABASE_URL)
#   SUPABASE_ANON_KEY     (same value as VITE_SUPABASE_ANON_KEY)
#   SITE_ORIGIN           https://sharemii.net
#   DISCORD_INVITE_URL    (optional — Organization schema sameAs for crawlers)
#
# Local Cloudflare dev (.env.local — never commit):
#   CLOUDFLARE_API_TOKEN=
#   CLOUDFLARE_ACCOUNT_ID=f16e70493ac68fe9b91d0bad3b925499

# Supabase Dashboard → Authentication → URL Configuration (add all of these):
# Site URL: https://sharemii.net  (or http://localhost:5173 for local dev)
# Redirect URLs:
#   http://localhost:5173
#   http://127.0.0.1:5173
#   http://localhost:4173
#   https://sharemii.net
#   https://www.sharemii.net
#
# OAuth (Google, GitHub, Discord): configure providers in Supabase Dashboard — no extra VITE_* keys.
# Step-by-step: library/OAUTH_SETUP.md
# Redirect URLs and allowed origins: src/services/auth.ts (AUTH_REDIRECT_ORIGINS).

# Optional: auto-sync supabase/sync.sql on npm run dev (Dashboard → Database → Connection string)
# DATABASE_URL=postgresql://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
# SUPABASE_DB_PASSWORD=

# Discord staff notifications (Edge Functions + DB triggers — never put in VITE_* vars)
#
# Moderation / content reports (discord-notify):
# 1. supabase secrets set DISCORD_WEBHOOK_URL=... DISCORD_NOTIFY_SECRET=...
# 2. Vault secret: discord_notify_secret (same value as DISCORD_NOTIFY_SECRET)
# 3. Deploy: supabase functions deploy discord-notify --no-verify-jwt
# 4. Apply migration 025_discord_notifications.sql
#
# Bug reports (discord-bug-notify) — separate webhook + secret:
# 1. supabase secrets set DISCORD_BUG_WEBHOOK_URL=... DISCORD_BUG_NOTIFY_SECRET=...
# 2. Vault secret: discord_bug_notify_secret (same value as DISCORD_BUG_NOTIFY_SECRET)
# 3. Deploy: supabase functions deploy discord-bug-notify --no-verify-jwt
# 4. Apply migration 027_discord_bug_notifications.sql
#
# Account deletion: supabase functions deploy delete-account --no-verify-jwt
# See supabase/.env.example for local function testing.
