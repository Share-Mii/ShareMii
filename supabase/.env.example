# Edge Function secrets (local: copy to supabase/.env — gitignored via *.local)
# Production: supabase secrets set --project-ref pkxxgclpibmogbusnusi
#
# Moderation / content reports (discord-notify)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# DISCORD_NOTIFY_SECRET=<random-string-must-match-vault-discord_notify_secret>

DISCORD_WEBHOOK_URL=
DISCORD_NOTIFY_SECRET=

# Bug reports (discord-bug-notify) — separate channel/webhook
# DISCORD_BUG_WEBHOOK_URL=https://discord.com/api/webhooks/...
# DISCORD_BUG_NOTIFY_SECRET=<random-string-must-match-vault-discord_bug_notify_secret>

DISCORD_BUG_WEBHOOK_URL=
DISCORD_BUG_NOTIFY_SECRET=

# delete-account Edge Function uses SUPABASE_URL, SUPABASE_ANON_KEY, and
# SUPABASE_SERVICE_ROLE_KEY automatically when deployed.
# Deploy: supabase functions deploy delete-account --no-verify-jwt
