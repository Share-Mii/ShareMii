# Optional — dev-only release UI at http://localhost:5173/update
#
# 1. Copy relevant lines into `.env.local` (same folder as package.json).
# 2. Restart `npm run dev`.
#
# Required — enables the /update page locally (omit or false = page hidden):
update.dev=true
#
# Required — Commit & Push publishes to Discord automatically:
DISCORD_WEBHOOK_URL_CHANGELOG=https://discord.com/api/webhooks/1513031669794476122/ufp8fLB3F8t_4_N4AF20o7J5tX5MPTXdvSK5ry1jaqhbeAPsrBNU4ZaKEe5AfRiBYvVG
#
# Optional — local passphrase before preview/commit/post:
# SHAREMII_UPDATE_TOOL_TOKEN=paste-a-long-random-string-here
#
# Optional — embed accent color (decimal RGB; default is ShareMii blue #0088ff = 35071):
# DISCORD_CHANGELOG_EMBED_COLOR=35071
#
# Changelog banner image: edit scripts/discordChangelogImageUrls.ts
